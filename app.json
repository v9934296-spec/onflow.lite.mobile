{
  "expo": {
    "name": "OnFlow Lite",
    "slug": "onflow-lite",
    "version": "1.0.0",
    "scheme": "onflowlite",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1A1A1C",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.onflow.lite",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "OnFlow Lite uses the camera to film skate clips for analysis.",
        "NSMicrophoneUsageDescription": "OnFlow Lite records audio with your skate clips.",
        "NSPhotoLibraryUsageDescription": "OnFlow Lite lets you pick skate clips from your library.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.onflow.lite",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-asset",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "3c8b5334-82f7-4286-ab87-2eb940a9037b"
      }
    }
  }
}
