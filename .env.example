# Copy to `.env` (or run: Copy-Item .env.example .env)
# Restart bundler after edits: `npx expo start -c`
#
# EAS preview / production: set EXPO_PUBLIC_API_URL in the EAS dashboard
# per environment — do not commit real backend URLs here.

# --- Production / shared backend ---
# EXPO_PUBLIC_API_URL=https://onflowskate-production.up.railway.app

# --- Local dev: LAN API (Android/iOS use as-is; web may rewrite to 127.0.0.1) ---
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Web only: set if the API is on a *different* machine (disables LAN→127.0.0.1 rewrite).
# EXPO_PUBLIC_API_URL_WEB=http://192.168.1.50:8000

# Dev only: auto POST /api/v1/auth/session on launch (requires working API URL).
# EXPO_PUBLIC_DEV_SKIP_SIGN_IN=true
# EXPO_PUBLIC_DEV_AUTO_EMAIL=you@example.com

# Legal page base URL (Terms, Privacy, delete-account info).
# EXPO_PUBLIC_LEGAL_BASE_URL=https://onflow-legal.pages.dev

# --- RevenueCat (public SDK key — paste after =) ---
# Dashboard → Project → API keys (appl_ / goog_ / test_)
# Entitlement: onflow-lite Pro | Packages: lifetime, yearly, monthly
# EAS: set EXPO_PUBLIC_REVENUECAT_API_KEY per environment (not in git)
EXPO_PUBLIC_REVENUECAT_API_KEY=
