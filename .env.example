# Copy to `.env`. Restart bundler after edits: `npx expo start -c`
#
# EAS preview / production: set EXPO_PUBLIC_API_URL in the EAS dashboard
# per environment — do not commit real backend URLs here.

EXPO_PUBLIC_API_URL=https://your-api.example.com

# Web only: set if the API is on a *different* machine (disables LAN→127.0.0.1 rewrite).
# EXPO_PUBLIC_API_URL_WEB=http://192.168.1.50:8000

# Dev only: auto POST /api/v1/auth/session on launch (requires working API URL).
# EXPO_PUBLIC_DEV_SKIP_SIGN_IN=true
# EXPO_PUBLIC_DEV_AUTO_EMAIL=you@example.com
