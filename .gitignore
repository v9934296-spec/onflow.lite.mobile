# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo (keep generated router types for typed routes + CI)
.expo/*
!.expo/types/
!.expo/types/**
dist/
dist-ios/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Native build outputs (generated per-build, never committed)
android/app/build/
ios/build/
ios/Pods/

# EAS logs / artifacts
eas-build-log*.txt
*.aab
*.apk
*.ipa

# Web export artifacts — generated by `expo export`, never committed
.expo-export-tmp/

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# macOS / OS
.DS_Store
Thumbs.db
*.pem

# local env files (real secrets / API URLs — never commit)
.env
.env.*
!.env.example
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
ios/
android/

# editor / tooling
.idea/
.vscode/
*.swp
*.swo
