# Copy this file to `.env` in this directory (`services/api/.env`).
#
# Deployed environments (Railway): set ONFLOW_ENV=production (or staging). Leaving this
# unset defaults to development and disables fail-closed JWT/Redis/S3/billing guards.
# ONFLOW_ENV=development
#
# **Clip review:** set `ONFLOW_GEMINI_API_KEY` here for local development. Without it, jobs complete with **`review_method: provider_unavailable`** (video checks only — no full AI review). `GET /health` returns `"gemini_configured": false`.
# Never put Gemini keys in the mobile app `.env` or any `EXPO_PUBLIC_*` variable — keys stay on the API only.
#
# **Production (Railway):** setting variables only in this repo does not change the live API. Set
# `ONFLOW_GEMINI_API_KEY` in the Railway service environment and redeploy.
#
# Daily Gemini spend cap (USD). 0 or unset = disabled. When set, new clip uploads return 429 after
# the day's estimated spend (Postgres gemini_spend_daily) exceeds this value.
# ONFLOW_GEMINI_DAILY_SPEND_CAP_USD=5.00

# Comma-separated origins or * (default, fine for local dev).
# For production, set to your mobile app's origin + Railway URL:
# ONFLOW_CORS_ORIGINS=https://your-app-origin.example
# Do not use * in production.
# ONFLOW_CORS_ORIGINS=*

# Directory for uploaded videos (created automatically)
ONFLOW_UPLOAD_DIR=data/uploads

# Consented users' completed clips + JSON sidecars (see clip_retention). Relative paths are under services/api/.
# ONFLOW_RETENTION_DIR=data/retained

# SQLite path for users, sessions, and beta feedback (always local).
# ONFLOW_DATABASE_PATH=data/onflow.db

# Clip jobs: Postgres URL, or empty to use SQLite at ONFLOW_DATABASE_PATH (same file).
# For Railway: set ONFLOW_DATABASE_URL to your Postgres connection string.
# ONFLOW_DATABASE_URL=postgresql://user:pass@host:5432/onflow

# Auth: JWT secret (min 32 chars). Required when ONFLOW_ENV is production/prod/staging.
# Empty in development = session + unsigned `dev:` tokens (never use that in deployed envs).
# ONFLOW_JWT_SECRET=

# Google / Apple Sign In (ID token verification on POST /api/v1/auth/google|apple)
# ONFLOW_GOOGLE_CLIENT_IDS=web_client_id,ios_client_id
# ONFLOW_APPLE_BUNDLE_ID=com.onflow.lite

# Product quota: max analyses per calendar month (UTC). Re-Up bonus applies after the cap.
# ONFLOW_RATE_LIMIT_FREE=3
# ONFLOW_RATE_LIMIT_PRO=30
# Coarse per-user per-day abuse ceiling (slowapi); business quota is monthly + bonus above.
# ONFLOW_RATE_LIMIT_ABUSE_PER_DAY=200

# RevenueCat (required when ONFLOW_ENV is production/prod/staging)
# ONFLOW_RC_WEBHOOK_SECRET=
# Store product IDs for Pro: lifetime, yearly, monthly (entitlement: onflow-lite Pro)
# ONFLOW_RC_PRO_PRODUCT_IDS=com.onflow.lite.lifetime,com.onflow.lite.yearly,com.onflow.lite.monthly
# ONFLOW_RC_PRODUCT_REUP_PACK=onflow_reup_pack_399
# Legacy one-time pack IDs that grant +3 bonus analyses (optional; for migrating old SKUs)
# ONFLOW_RC_LEGACY_BONUS_PRODUCT_IDS=
#
# Quota charge is Postgres FOR UPDATE–safe. Feed SSE hub is still in-process (one replica or pin).

# Gemini API key (required for clip review)
# Get yours at https://aistudio.google.com/apikey
ONFLOW_GEMINI_API_KEY=
# Optional: if ONFLOW_GEMINI_API_KEY is empty, the API also reads GEMINI_API_KEY (unprefixed).
# GEMINI_API_KEY=

# Tiered models (optional — defaults: free = Flash-Lite, pro/coach = Flash).
# Main clip analysis and optional enrichment both use the same tier → model mapping
# (``app.core.tiers.resolve_gemini_model_for_tier``). Jobs still require valid Gemini
# output to complete; there is no placeholder “completed” review if the provider fails.
# ONFLOW_GEMINI_MODEL_FREE=gemini-2.5-flash-lite
# ONFLOW_GEMINI_MODEL_PRO=gemini-2.5-flash
# Legacy single-model fallback when a tier-specific name is left empty:
# ONFLOW_GEMINI_MODEL=gemini-2.5-flash

# Primary Pro-tier analysis engine key (Twelve Labs Pegasus). Get a key at https://twelvelabs.io/
ONFLOW_TWELVELABS_API_KEY=

# Twelve Labs Pegasus — optional tuning (free tier stays on Gemini).
# ONFLOW_TWELVELABS_MODEL=pegasus1.5
# ONFLOW_TWELVELABS_TIMEOUT_SECONDS=90
# ONFLOW_TWELVELABS_MAX_RETRIES=1
# ONFLOW_TWELVELABS_MAX_OUTPUT_TOKENS=8192
# Emergency rollback: Pro tier uses Gemini Flash instead of Pegasus.
# ONFLOW_FORCE_GEMINI_FOR_PRO=false

# RevenueCat webhook secret (set in RC dashboard → Webhooks → Authorization header value)
# ONFLOW_RC_WEBHOOK_SECRET=whsec_your_secret_here

# Comma-separated operator emails auto-promoted to users.is_admin on verified OAuth sign-in.
# Required in production/staging — /api/v1/admin/* routes need Bearer auth plus users.is_admin.
# Invalid or duplicate entries fail startup validation.
# ONFLOW_ADMIN_EMAILS=ops@onflow.test,founder@onflow.test

# --- Cloudflare R2 (S3-compatible clip uploads) ---
# REQUIRED when ONFLOW_ENV=production|staging (API refuses to boot without all four).
# Local dev: optional — without these, initiate-upload returns local:// URLs (simulator OK; real iPhone needs R2).
#
# Setup (Cloudflare dashboard):
#   1. R2 → Create bucket (e.g. onflow-clips)
#   2. R2 → Manage R2 API Tokens → Create token → Object Read & Write on that bucket
#   3. Copy Access Key ID + Secret Access Key from the token (shown once)
#   4. Endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#      (Account ID: Cloudflare dashboard → R2 overview, right sidebar)
#   5. API uses boto3 region_name=auto (required for R2 presigned PUTs).
#
# Railway: set all four on BOTH API and worker services, then redeploy.
# Device symptom of bad R2 creds/signature: Capture stays open with
# "Clip storage rejected the upload (401)" — not a sign-out.
#
ONFLOW_S3_BUCKET=
ONFLOW_S3_ENDPOINT=
ONFLOW_S3_ACCESS_KEY=
ONFLOW_S3_SECRET_KEY=

# Postgres in production — Railway pre-deploy: ``python3.12 -m alembic upgrade head`` (see railway.toml).

# Redis URL — required in production/staging (ONFLOW_ENV=production|prod|staging).
# Used by: ARQ clip worker queue, slowapi distributed rate limits, delete-account throttle.
# Without this in multi-replica deploys, each API instance keeps its own in-memory counters.
# For Railway: add a Redis service and use its internal URL (same value on API + worker).
# ONFLOW_REDIS_URL=redis://default:password@redis.railway.internal:6379
